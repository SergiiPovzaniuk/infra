server:
  http_listen_port: 9080
clients:
  - url: http://{{ hostvars[groups['monitoring'][0]].tailscale_ip | default(hostvars[groups['monitoring'][0]].ansible_host) }}:3100/loki/api/v1/push
positions:
  filename: /positions/positions.yaml
scrape_configs:
  - job_name: system
    static_configs:
      - targets: [localhost]
        labels:
          host: {{ inventory_hostname }}
          job: syslog
          __path__: /var/log/*.log
