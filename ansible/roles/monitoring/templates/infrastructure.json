{
  "title": "Infrastructure",
  "panels": [
    {
      "type": "stat",
      "title": "Reachable hosts",
      "targets": [{"expr": "sum(up{job=\"node\"})"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
